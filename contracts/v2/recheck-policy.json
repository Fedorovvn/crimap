  "confirmedClarifications": [
    {"field": "stages", "status": "user-confirmed", "reason": "0–3 hours every 15 minutes; then fewer daytime checks through the first year."},
    {"field": "pendingFactCheckAgesSeconds", "status": "user-confirmed", "reason": "Unpublished events awaiting an occurrence date or a confirmed death receive two checks in four hours and three more through the following week, then stop active research."}
  ],
  "stages": [
    {
      "minAgeSeconds": 0,
      "maxAgeSecondsExclusive": 10800,
      "intervalSeconds": 900,
      "schedule": "interval"
    },
    {
      "minAgeSeconds": 10800,
      "maxAgeSecondsExclusive": 86400,
      "intervalSeconds": 14400,
      "schedule": "daytime-interval",
      "activeHours": {"start": 10, "endExclusive": 22}
    },
    {
      "minAgeSeconds": 86400,
      "maxAgeSecondsExclusive": 259200,
      "intervalSeconds": 43200,
      "schedule": "daily-times",
      "dailyHours": [10, 18]
    },
    {
      "minAgeSeconds": 259200,
      "maxAgeSecondsExclusive": 864000,
      "intervalSeconds": 86400,
      "schedule": "daily-times",
      "dailyHours": [10]
    },
    {
      "minAgeSeconds": 864000,
      "maxAgeSecondsExclusive": 2592000,
      "intervalSeconds": 1209600,
      "schedule": "interval"
    },
    {
      "minAgeSeconds": 2592000,
      "maxAgeSecondsExclusive": 31536000,
      "intervalSeconds": 2592000,
      "schedule": "interval"
    }
  ],
  "pendingFactCheckAgesSeconds": [7200, 14400, 86400, 259200, 604800],
  "stopAtAgeSeconds": 31536000,
  "initialCheck": "immediate-if-younger-than-stop-age",
  "nextCheckAnchor": "successful-check-completion",
  "newPublicationResetsEventAge": false,
  "catchUpPolicy": "one-current-check",
  "retainEventAfterStop": true,
  "incomingUpdatesAfterStop": "allow-linking-without-restarting-periodic-checks"
