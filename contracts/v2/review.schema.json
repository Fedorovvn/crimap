{
  "$ref": "#/definitions/review",
  "definitions": {
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "revise",
            "reject"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "field": {
                "$ref": "#/definitions/review/properties/summary"
              },
              "reason": {
                "$ref": "#/definitions/review/properties/summary"
              },
              "documentId": {
                "type": "string"
              },
              "quote": {
                "$ref": "#/definitions/review/properties/summary"
              },
              "quoteOrigin": {
                "type": "string",
                "enum": [
                  "source",
                  "english",
                  "russian",
                  "translation"
                ]
              }
            },
            "required": [
              "severity",
              "field",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "field",
                  "incident-type",
                  "participant-status",
                  "source-type",
                  "display"
                ]
              },
              "proposedKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "reason": {
                "$ref": "#/definitions/review/properties/requests/items/properties/label"
              },
              "example": {
                "$ref": "#/definitions/review/properties/requests/items/properties/label"
              },
              "documentId": {
                "type": "string"
              },
              "quote": {
                "$ref": "#/definitions/review/properties/requests/items/properties/label"
              }
            },
            "required": [
              "kind",
              "proposedKey",
              "label",
              "reason",
              "example"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "locationResolution": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "search"
                },
                "queries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 160
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "stop",
                          "landmark",
                          "street",
                          "address",
                          "intersection"
                        ]
                      },
                      "streets": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 100
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "surface": {
                        "type": "string",
                        "enum": [
                          "road",
                          "tram",
                          "rail",
                          "waterfront",
                          "building",
                          "area"
                        ]
                      },
                      "mapQuery": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 160
                      },
                      "documentId": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "label",
                      "kind",
                      "documentId",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 2
                }
              },
              "required": [
                "action",
                "queries"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "select"
                },
                "candidateId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "action",
                "candidateId",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "keep"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "action",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "verdict",
        "summary",
        "issues",
        "requests"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
