{
  "$ref": "#/definitions/event",
  "definitions": {
    "event": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "summary": {
          "$ref": "#/definitions/event/properties/title"
        },
        "type": {
          "type": "string",
          "enum": [
            "traffic-accident",
            "assault",
            "fight",
            "robbery",
            "accident",
            "fire",
            "rescue",
            "missing-person",
            "transport-disruption",
            "weather",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "investigating",
            "suspects-detained",
            "wanted",
            "resolved",
            "closed",
            "unknown"
          ]
        },
        "occurredAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "timePrecision": {
          "type": "string",
          "enum": [
            "exact",
            "hour",
            "day",
            "unknown"
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "$ref": "#/definitions/event/properties/title"
            },
            "district": {
              "$ref": "#/definitions/event/properties/title"
            },
            "label": {
              "$ref": "#/definitions/event/properties/title"
            },
            "precision": {
              "type": "string",
              "enum": [
                "exact",
                "street",
                "landmark",
                "district",
                "city",
                "unknown"
              ]
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "city",
            "label",
            "precision"
          ],
          "additionalProperties": false
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "death",
              "injury",
              "suspect-detained",
              "suspect-wanted"
            ]
          }
        },
        "caseReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event/properties/title"
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "suspect",
                  "victim",
                  "convicted",
                  "involved"
                ]
              },
              "label": {
                "$ref": "#/definitions/event/properties/title"
              },
              "status": {
                "type": "string",
                "enum": [
                  "detained",
                  "wanted",
                  "in-custody",
                  "charged",
                  "convicted",
                  "released",
                  "deceased",
                  "injured",
                  "unknown"
                ]
              },
              "profile": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "person"
                      },
                      "name": {
                        "$ref": "#/definitions/event/properties/title"
                      },
                      "gender": {
                        "type": "string",
                        "enum": [
                          "male",
                          "female"
                        ]
                      },
                      "age": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 120
                      },
                      "ageGroup": {
                        "type": "string",
                        "enum": [
                          "child",
                          "adult",
                          "older"
                        ]
                      },
                      "citizenship": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "pattern": "^[A-Z]{2}$"
                          },
                          "name": {
                            "$ref": "#/definitions/event/properties/title"
                          }
                        },
                        "required": [
                          "code",
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "group"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "gender": {
                        "type": "string",
                        "enum": [
                          "male",
                          "female"
                        ]
                      },
                      "leader": {
                        "type": "object",
                        "properties": {
                          "person": {
                            "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/0"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "detained",
                              "wanted",
                              "in-custody",
                              "charged",
                              "convicted",
                              "released",
                              "deceased",
                              "injured",
                              "unknown"
                            ]
                          },
                          "sourceUrl": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "person",
                          "status",
                          "sourceUrl"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "note": {
                "$ref": "#/definitions/event/properties/title"
              },
              "wantedNotice": {
                "type": "object",
                "properties": {
                  "description": {
                    "$ref": "#/definitions/event/properties/title"
                  },
                  "sourceUrl": {
                    "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
                  },
                  "isDemo": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "description"
                ],
                "additionalProperties": false
              },
              "sourceUrl": {
                "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
              },
              "sourceLabel": {
                "$ref": "#/definitions/event/properties/title"
              },
              "asOf": {
                "$ref": "#/definitions/event/properties/occurredAt/anyOf/0"
              }
            },
            "required": [
              "key",
              "role",
              "label",
              "status",
              "profile",
              "sourceUrl",
              "sourceLabel",
              "asOf"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/definitions/event/properties/participants/items/properties/key"
              },
              "subject": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "event"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "participant"
                      },
                      "participantKey": {
                        "$ref": "#/definitions/event/properties/participants/items/properties/key"
                      }
                    },
                    "required": [
                      "kind",
                      "participantKey"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "topic": {
                "type": "string",
                "enum": [
                  "motive",
                  "circumstances",
                  "citizenship",
                  "occupation",
                  "visitor-status",
                  "housing-status",
                  "appearance"
                ]
              },
              "text": {
                "$ref": "#/definitions/event/properties/title"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "source",
                  "model"
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "unverified",
                  "corroborated",
                  "disputed",
                  "retracted"
                ]
              },
              "reviewStatus": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "official",
                        "media",
                        "eyewitness",
                        "social"
                      ]
                    },
                    "label": {
                      "$ref": "#/definitions/event/properties/title"
                    },
                    "url": {
                      "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
                    },
                    "attribution": {
                      "$ref": "#/definitions/event/properties/title"
                    },
                    "relation": {
                      "type": "string",
                      "enum": [
                        "supports",
                        "disputes",
                        "background"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "url",
                    "relation"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "asOf": {
                "$ref": "#/definitions/event/properties/occurredAt/anyOf/0"
              },
              "rationale": {
                "$ref": "#/definitions/event/properties/title"
              }
            },
            "required": [
              "key",
              "subject",
              "topic",
              "text",
              "origin",
              "verification",
              "reviewStatus",
              "evidence",
              "asOf"
            ],
            "additionalProperties": false
          },
          "maxItems": 40
        },
        "legal": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "const": "HU"
              },
              "subjectLabel": {
                "$ref": "#/definitions/event/properties/legal/items/properties/key"
              },
              "participantKey": {
                "$ref": "#/definitions/event/properties/legal/items/properties/key"
              },
              "offense": {
                "$ref": "#/definitions/event/properties/legal/items/properties/key"
              },
              "qualification": {
                "type": "string",
                "enum": [
                  "official",
                  "reported",
                  "possible"
                ]
              },
              "stage": {
                "type": "string",
                "enum": [
                  "investigation",
                  "charged",
                  "trial",
                  "judgment"
                ]
              },
              "source": {
                "type": "object",
                "properties": {
                  "label": {
                    "$ref": "#/definitions/event/properties/legal/items/properties/key"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "official",
                      "media"
                    ]
                  },
                  "publishedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "label",
                  "url",
                  "kind",
                  "publishedAt"
                ],
                "additionalProperties": false
              },
              "statuteMatch": {
                "type": "string",
                "enum": [
                  "source-explicit",
                  "editorial"
                ]
              },
              "statutes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "criminal",
                        "petty-offense",
                        "administrative"
                      ]
                    },
                    "act": {
                      "$ref": "#/definitions/event/properties/legal/items/properties/key"
                    },
                    "section": {
                      "$ref": "#/definitions/event/properties/legal/items/properties/key"
                    },
                    "url": {
                      "$ref": "#/definitions/event/properties/legal/items/properties/source/properties/url"
                    },
                    "versionDate": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "required": [
                    "code",
                    "act",
                    "section",
                    "url",
                    "versionDate"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "penalties": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "imprisonment"
                        },
                        "min": {
                          "type": "number",
                          "minimum": 0
                        },
                        "max": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "years",
                            "months"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "max",
                        "unit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "fine"
                        },
                        "min": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                        },
                        "max": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                        },
                        "unit": {
                          "type": "string",
                          "const": "HUF"
                        }
                      },
                      "required": [
                        "kind",
                        "max",
                        "unit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "detention"
                        },
                        "min": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                        },
                        "max": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                        },
                        "unit": {
                          "type": "string",
                          "const": "days"
                        }
                      },
                      "required": [
                        "kind",
                        "max",
                        "unit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "community-service"
                        },
                        "min": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                        },
                        "max": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                        },
                        "unit": {
                          "type": "string",
                          "const": "hours"
                        }
                      },
                      "required": [
                        "kind",
                        "max",
                        "unit"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "life-imprisonment"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "driving-ban"
                        },
                        "text": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/key"
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "other"
                        },
                        "text": {
                          "$ref": "#/definitions/event/properties/legal/items/properties/key"
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "condition": {
                "$ref": "#/definitions/event/properties/legal/items/properties/key"
              },
              "reviewStatus": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved"
                ]
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "key",
              "jurisdiction",
              "subjectLabel",
              "offense",
              "qualification",
              "stage",
              "source",
              "statuteMatch",
              "statutes",
              "penalties",
              "condition",
              "reviewStatus",
              "checkedAt"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/definitions/event/properties/participants/items/properties/key"
              },
              "publishedAt": {
                "$ref": "#/definitions/event/properties/occurredAt/anyOf/0"
              },
              "title": {
                "$ref": "#/definitions/event/properties/title"
              },
              "detail": {
                "$ref": "#/definitions/event/properties/title"
              },
              "sourceUrl": {
                "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
              }
            },
            "required": [
              "key",
              "publishedAt",
              "title",
              "detail",
              "sourceUrl"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "imageUrl": {
                "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
              },
              "sourceUrl": {
                "$ref": "#/definitions/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
              },
              "outlet": {
                "$ref": "#/definitions/event/properties/title"
              },
              "credit": {
                "$ref": "#/definitions/event/properties/title"
              },
              "caption": {
                "$ref": "#/definitions/event/properties/title"
              },
              "isSensitive": {
                "type": "boolean"
              },
              "rights": {
                "type": "string",
                "enum": [
                  "unknown",
                  "link-only",
                  "licensed",
                  "permission",
                  "public-domain"
                ]
              }
            },
            "required": [
              "imageUrl",
              "sourceUrl",
              "outlet",
              "credit",
              "caption",
              "isSensitive",
              "rights"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "$ref": "#/definitions/event/properties/title"
              },
              "documentId": {
                "$ref": "#/definitions/event/properties/title"
              },
              "quote": {
                "$ref": "#/definitions/event/properties/title"
              },
              "attribution": {
                "$ref": "#/definitions/event/properties/title"
              }
            },
            "required": [
              "field",
              "documentId",
              "quote"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 150
        }
      },
      "required": [
        "title",
        "summary",
        "type",
        "status",
        "occurredAt",
        "timePrecision",
        "location",
        "signals",
        "caseReferences",
        "participants",
        "context",
        "legal",
        "updates",
        "media",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
