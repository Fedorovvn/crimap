                                "criminal",
                                "petty-offense",
                                "administrative"
                              ]
                            },
                            "act": {
                              "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
                            },
                            "section": {
                              "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
                            },
                            "url": {
                              "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/source/properties/url"
                            },
                            "versionDate": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            }
                          },
                          "required": [
                            "code",
                            "act",
                            "section",
                            "url",
                            "versionDate"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "penalties": {
                        "type": "array",
