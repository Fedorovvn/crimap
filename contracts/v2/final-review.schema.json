                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "official",
                              "media"
                            ]
                          },
                          "publishedAt": {
                            "type": "string",
