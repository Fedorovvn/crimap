                              "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                            },
                            "url": {
                              "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
                            },
                            "attribution": {
                              "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                            },
                            "relation": {
                              "type": "string",
                              "enum": [
                                "supports",
                                "disputes",
                                "background"
