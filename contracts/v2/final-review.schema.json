{
  "$ref": "#/definitions/final-review",
  "definitions": {
    "final-review": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "revise",
            "reject"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "field": {
                "$ref": "#/definitions/final-review/properties/summary"
              },
              "reason": {
                "$ref": "#/definitions/final-review/properties/summary"
              },
              "documentId": {
                "type": "string"
              },
              "quote": {
                "$ref": "#/definitions/final-review/properties/summary"
              },
              "quoteOrigin": {
                "type": "string",
                "enum": [
                  "source",
                  "english",
                  "russian",
                  "translation"
                ]
              }
            },
            "required": [
              "severity",
              "field",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "field",
                  "incident-type",
                  "participant-status",
                  "source-type",
                  "display"
                ]
              },
              "proposedKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,99}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "reason": {
                "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
              },
              "example": {
                "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
              },
              "documentId": {
                "type": "string"
              },
              "quote": {
                "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
              }
            },
            "required": [
              "kind",
              "proposedKey",
              "label",
              "reason",
              "example"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "locationResolution": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "search"
                },
                "queries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 160
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "stop",
                          "landmark",
                          "street",
                          "address",
                          "intersection"
                        ]
                      },
                      "streets": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 100
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "surface": {
                        "type": "string",
                        "enum": [
                          "road",
                          "tram",
                          "rail",
                          "waterfront",
                          "building",
                          "area"
                        ]
                      },
                      "mapQuery": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 160
                      },
                      "documentId": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "label",
                      "kind",
                      "documentId",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 2
                }
              },
              "required": [
                "action",
                "queries"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "select"
                },
                "candidateId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "action",
                "candidateId",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "keep"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "action",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "legalCoverage": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "mapped",
                "partial",
                "insufficient-facts",
                "no-catalog-match",
                "no-suspect",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2000
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "documentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "documentId",
                  "quote"
                ],
                "additionalProperties": false
              },
              "maxItems": 5
            },
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "participantKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "mapped",
                      "insufficient-facts",
                      "no-catalog-match",
                      "no-suspect",
                      "not-applicable"
                    ]
                  },
                  "reason": {
                    "$ref": "#/definitions/final-review/properties/legalCoverage/properties/reason"
                  },
                  "basis": {
                    "$ref": "#/definitions/final-review/properties/legalCoverage/properties/basis"
                  }
                },
                "required": [
                  "participantKey",
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            }
          },
          "required": [
            "status",
            "reason",
            "participants"
          ],
          "additionalProperties": false
        },
        "publicationSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "final": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "title": {
                  "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                },
                "summary": {
                  "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "traffic-accident",
                    "assault",
                    "fight",
                    "robbery",
                    "accident",
                    "fire",
                    "rescue",
                    "missing-person",
                    "transport-disruption",
                    "weather",
                    "other"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "reported",
                    "investigating",
                    "suspects-detained",
                    "wanted",
                    "resolved",
                    "closed",
                    "unknown"
                  ]
                },
                "occurredAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "timePrecision": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "hour",
                    "day",
                    "unknown"
                  ]
                },
                "location": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                    },
                    "district": {
                      "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                    },
                    "label": {
                      "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                    },
                    "precision": {
                      "type": "string",
                      "enum": [
                        "exact",
                        "street",
                        "landmark",
                        "district",
                        "city",
                        "unknown"
                      ]
                    },
                    "latitude": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "longitude": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  },
                  "required": [
                    "city",
                    "label",
                    "precision"
                  ],
                  "additionalProperties": false
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "death",
                      "injury",
                      "suspect-detained",
                      "suspect-wanted"
                    ]
                  }
                },
                "caseReferences": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                  }
                },
                "participants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "suspect",
                          "victim",
                          "convicted",
                          "involved"
                        ]
                      },
                      "label": {
                        "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "detained",
                          "wanted",
                          "in-custody",
                          "charged",
                          "convicted",
                          "released",
                          "deceased",
                          "injured",
                          "unknown"
                        ]
                      },
                      "profile": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "person"
                              },
                              "name": {
                                "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                              },
                              "gender": {
                                "type": "string",
                                "enum": [
                                  "male",
                                  "female"
                                ]
                              },
                              "age": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 120
                              },
                              "ageGroup": {
                                "type": "string",
                                "enum": [
                                  "child",
                                  "adult",
                                  "older"
                                ]
                              },
                              "citizenship": {
                                "type": "object",
                                "properties": {
                                  "code": {
                                    "type": "string",
                                    "pattern": "^[A-Z]{2}$"
                                  },
                                  "name": {
                                    "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                                  }
                                },
                                "required": [
                                  "code",
                                  "name"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "group"
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "gender": {
                                "type": "string",
                                "enum": [
                                  "male",
                                  "female"
                                ]
                              },
                              "leader": {
                                "type": "object",
                                "properties": {
                                  "person": {
                                    "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/profile/anyOf/0"
                                  },
                                  "status": {
                                    "type": "string",
                                    "enum": [
                                      "detained",
                                      "wanted",
                                      "in-custody",
                                      "charged",
                                      "convicted",
                                      "released",
                                      "deceased",
                                      "injured",
                                      "unknown"
                                    ]
                                  },
                                  "sourceUrl": {
                                    "type": "string",
                                    "format": "uri"
                                  }
                                },
                                "required": [
                                  "person",
                                  "status",
                                  "sourceUrl"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "note": {
                        "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                      },
                      "wantedNotice": {
                        "type": "object",
                        "properties": {
                          "description": {
                            "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                          },
                          "sourceUrl": {
                            "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
                          },
                          "isDemo": {
                            "type": "boolean",
                            "const": false
                          }
                        },
                        "required": [
                          "description"
                        ],
                        "additionalProperties": false
                      },
                      "sourceUrl": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/profile/anyOf/1/properties/leader/properties/sourceUrl"
                      },
                      "sourceLabel": {
                        "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                      },
                      "asOf": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/occurredAt/anyOf/0"
                      }
                    },
                    "required": [
                      "key",
                      "role",
                      "label",
                      "status",
                      "profile",
                      "sourceUrl",
                      "sourceLabel",
                      "asOf"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                },
                "context": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/key"
                      },
                      "subject": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "event"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "participant"
                              },
                              "participantKey": {
                                "$ref": "#/definitions/final-review/properties/final/properties/event/properties/participants/items/properties/key"
                              }
                            },
                            "required": [
                              "kind",
                              "participantKey"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "topic": {
                        "type": "string",
                        "enum": [
                          "motive",
                          "circumstances",
                          "citizenship",
                          "occupation",
                          "visitor-status",
                          "housing-status",
                          "appearance"
                        ]
                      },
                      "text": {
                        "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "source",
                          "model"
