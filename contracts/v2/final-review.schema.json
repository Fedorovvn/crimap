                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "imprisonment"
                                },
                                "min": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "max": {
                                  "type": "number",
                                  "exclusiveMinimum": 0
                                },
                                "unit": {
                                  "type": "string",
                                  "enum": [
                                    "years",
                                    "months"
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "max",
                                "unit"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "fine"
                                },
                                "min": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                                },
                                "max": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                                },
                                "unit": {
                                  "type": "string",
                                  "const": "HUF"
                                }
                              },
                              "required": [
                                "kind",
                                "max",
                                "unit"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "detention"
                                },
                                "min": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                                },
                                "max": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                                },
                                "unit": {
                                  "type": "string",
                                  "const": "days"
                                }
                              },
                              "required": [
                                "kind",
                                "max",
                                "unit"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "community-service"
                                },
                                "min": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/min"
                                },
                                "max": {
                                  "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/penalties/items/anyOf/0/properties/max"
                                },
                                "unit": {
                                  "type": "string",
                                  "const": "hours"
                                }
                              },
                              "required": [
