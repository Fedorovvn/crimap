                      "asOf": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/occurredAt/anyOf/0"
                      },
                      "rationale": {
                        "$ref": "#/definitions/final-review/properties/requests/items/properties/label"
                      }
                    },
                    "required": [
                      "key",
                      "subject",
                      "topic",
                      "text",
                      "origin",
                      "verification",
                      "reviewStatus",
                      "evidence",
                      "asOf"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 40
                },
                "legal": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "jurisdiction": {
                        "type": "string",
                        "const": "HU"
                      },
                      "subjectLabel": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
                      },
                      "participantKey": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
                      },
                      "offense": {
                        "$ref": "#/definitions/final-review/properties/final/properties/event/properties/legal/items/properties/key"
