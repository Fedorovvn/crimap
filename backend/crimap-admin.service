[Unit]
Description=Crimap editorial dashboard
After=network.target

[Service]
Type=simple
User=crimap
Group=crimap
WorkingDirectory=/srv/crimap/app
EnvironmentFile=/etc/crimap/admin.env
EnvironmentFile=-/etc/crimap/push.env
ExecStart=/srv/crimap/runtime/node/bin/node backend/admin-server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/crimap/data
MemoryMax=256M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
