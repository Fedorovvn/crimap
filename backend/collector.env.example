# Copy outside the repository; never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
MODEL_DAILY_BUDGET_USD=0.50
BRAVE_SEARCH_API_KEY=
SEARCH_DAILY_LIMIT=50
COLLECTOR_DATABASE_PATH=/srv/crimap/data/collector.sqlite
DATABASE_PATH=/srv/crimap/data/incidents.sqlite
COLLECTOR_SOURCES=police-brfk,okf-events,kekvillogo
FEED_MAX_ITEMS=3
# After a successful Pro review, publish assaults and fatal incidents automatically.
AUTO_PUBLISH_QUALIFIED_EVENTS=true

# Optional Photon endpoint; cached, at most 80 uncached queries/day, 16s spacing.
GEOCODER_URL=https://photon.komoot.io/api/
# One-off archive budgets are set per campaign with CLI --budget, not here.
